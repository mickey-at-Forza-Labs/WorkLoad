{
    "name": "dynamo",
    "AWSTemplateFormatVersion": "2010-09-09",
    "Transform": "AWS::Serverless-2016-10-31",
    "Description": "Quality and Risk Frontend Template",
    "Conditions": {},
    "Mappings": {},
    "Parameters": {},
    "Injections": [
        {
            "injectionType": "dynamo",
            "baseTemplate": {
                "${{resourceName}}": {
                    "Type": "AWS::DynamoDB::Table",
                    "Properties": {
                        "TableName": "${{tableName}}",
                        "DeletionProtectionEnabled": true,
                        "BillingMode": "PAY_PER_REQUEST",
                        "AttributeDefinitions": [
                            {
                                "AttributeName": "uuid",
                                "AttributeType": "S"
                            }
                        ],
                        "KeySchema": [
                            {
                                "AttributeName": "uuid",
                                "KeyType": "HASH"
                            }
                        ],
                        "ResourcePolicy": {
                            "PolicyDocument": {
                                "Version": "2012-10-17",
                                "Statement": [
                                    {
                                        "Effect": "Deny",
                                        "Action": "dynamodb:*",
                                        "Resource": "*",
                                        "Principal": "*",
                                        "Condition": {
                                            "Bool": {
                                                "aws:SecureTransport": "false"
                                            }
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            "DynamoTables": [
                {
                    "tableName": "ngpComments"
                },
                {
                    "tableName": "ngpUiSchemas"
                }
            ]
        }
    ],
    "Resources": {},
    "Outputs": {}
}