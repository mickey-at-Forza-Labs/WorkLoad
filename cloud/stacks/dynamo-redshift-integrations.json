{
  "name": "DynamoIntegration",
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "zeroETL integration from dynamo to redshift",
  "Resources": {},
  "Injections": [
    {
      "injectionType": "dynamo",
      "baseTemplate": {
        "${{resourceName}}ZeroEtlIntegration": {
          "Type": "AWS::Redshift::Integration",
          "Properties": {
            "IntegrationName": "${{resourceName}}-zero-etl",
            "SourceArn": {
              "Fn::Sub": "arn:aws:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${{tableName}}"
            },
            "TargetArn": {
              "Fn::ImportValue": "nexusRedshiftNamespaceExport"
            }
          }
        }
      },
      "DynamoTables": [
        {
          "tableName": "vbpsApprovals",
          "customStatements": []
        },
        {
          "tableName": "vbpsSettlements",
          "customStatements": []
        },
        {
          "tableName": "vbpsContracts",
          "customStatements": []
        }
      ],
      "customStatements": []
    }
  ],
  "OutputInjections": [
    {
      "injectionType": "custom",
      "baseTemplate": {
        "${{resourceName}}ZeroEtlIntegrationArn": {
          "Value": {
            "Fn::GetAtt": "${{resourceName}}DynamoIntegrationZeroEtlIntegration.IntegrationArn"
          },
          "Export": {
            "Name": "${{resourceName}}DynamoIntegrationZeroEtlIntegration"
          }
        }
      },
      "customResource": [
        "vbpsSettlements",
        "vbpsContracts",
        "vbpsApprovals"
      ],
      "customReplaceValue": []
    }
  ],
  "Outputs": {}
}